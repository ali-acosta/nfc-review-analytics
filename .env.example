# Copia este archivo a .env y completa los valores.
# Todos los valores tienen default seguro para correr localmente sin configurar nada.

# URL base con la que se arman los links de los chips NFC y los códigos QR.
# CRÍTICO: debe apuntar al dominio propio definitivo ANTES de grabar chips o imprimir
# placas. Una vez instalada una placa, su URL no se puede cambiar nunca más.
BASE_URL=http://localhost:8000

# Zona horaria de los negocios. Los eventos se guardan en UTC, pero los informes
# y los gráficos se agrupan en hora local: sin esto, la cena de un restaurante
# aparecería al día siguiente y el último día del mes se iría al informe
# siguiente. Nombre IANA (America/Santiago, America/Bogota, Europe/Madrid…).
TIMEZONE=America/Santiago

# Detalle de los logs. DEBUG registra cada consulta a la base y llena el panel
# de logs del hosting; INFO es lo razonable en producción.
LOG_LEVEL=INFO

# Firma las cookies de sesión del panel. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si se deja vacía, se genera una al arrancar: sirve en desarrollo, pero en
# producción cada reinicio cerraría la sesión de todos los clientes.
SESSION_SECRET=

# Cadena de conexión SQLAlchemy. Por defecto usa SQLite local (cero configuración).
# Para producción, apuntar a un Postgres gratuito (ej. Supabase/Neon):
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/basededatos
DATABASE_URL=sqlite:///./nfc_analytics.db

# Telegram Bot API (opcional). Si se deja vacío, las alertas se omiten (no rompe la app).
# Cómo obtenerlo gratis: hablar con @BotFather en Telegram para crear un bot y token;
# el chat id personal se obtiene hablando con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertas por correo (opcional, y probablemente el canal más efectivo: un dueño
# de pyme revisa su correo a diario, Telegram quizá ni lo tenga instalado).
# Funciona con cualquier SMTP; el free tier de Brevo (300 correos/día) sobra.
# El destinatario se configura por negocio, no aquí.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
